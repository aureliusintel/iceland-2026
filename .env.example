# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The code you text Amanda and Eva
TRIP_PASSCODE=pick-something-memorable
# Any long random string; Vercel Cron sends it automatically
CRON_SECRET=generate-a-long-random-string
# MET Norway asks for contact info in the User-Agent (an email or website)
MET_CONTACT=you@example.com
